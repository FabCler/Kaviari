// Kaviari Cellar — caviar inventory, purchasing & marketing.
//
// The Order & Supply Management System (OSMS) used to share this schema.
// It now has its own datasource, its own client and its own master data in
// prisma/osms/schema.prisma; the only thing the two sides share is the
// signed-in account's email address. Nothing here may reference an OSMS
// table, and nothing there may reference one of these.
//
// SQLite for local dev. To switch to Postgres: change `provider` to
// "postgresql", point DATABASE_URL at the server, and re-run migrations.
// SQLite has no native enums, so status/type columns are strings validated
// by the zod schemas in lib/domain.ts — this also keeps the Postgres
// switch trivial.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id                     String  @id @default(cuid())
  // Canonical product code from the product database (PR Code).
  prCode                 String  @unique
  name                   String
  // Kristal | Oscietra | Baeri | Beluga | Daurikus | Transmontanus | Baenki
  caviarType             String?
  // Caviar | Marketing Tools | Fish Roe | Crab | Fish
  category               String  @default("Caviar")
  // Stock-keeping unit: Tin | PC | KG | PK
  unit                   String  @default("Tin")
  // Tins per full supplier box — orders are rounded up to whole boxes.
  packingPerBox          Int?
  // Net grams per unit (kg reference only; null for non-weighed items).
  gramsPerUnit           Int?
  unitCost               Float
  currency               String  @default("EUR")
  imageUrl               String?
  active                 Boolean @default(true)
  isPlaceholder          Boolean @default(false)
  // Manual ADU override (units/day) for seasonality or new products.
  aduOverrideUnitsPerDay Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lots      StockLot[]
  movements StockMovement[]
  poLines   PurchaseOrderLine[]
  campaigns CampaignProduct[]
  forecasts Forecast[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("member") // owner | member
  status       String   @default("pending") // pending | approved | rejected
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  forecasts Forecast[]
  chats     ChatSession[]
}

// One assistant conversation, private to its user.
model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model Forecast {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // First day of the forecast month (UTC midnight).
  month     DateTime
  // Forecast quantity in the product's unit (tins for caviar).
  quantity  Float
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, month])
  @@index([productId, month])
}

model StockLot {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  lotNumber    String
  // Units remaining in the lot (receipts add, consumption subtracts).
  quantityTins Float
  receivedTins Float
  receivedDate DateTime
  expiryDate   DateTime // DLC
  status       String   @default("in_stock") // in_stock | consumed | expired | written_off
  createdAt    DateTime @default(now())

  movements StockMovement[]

  @@index([productId, expiryDate])
}

model StockMovement {
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  lotId           String?
  lot             StockLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)
  // receipt | consumption | sale | waste | adjustment | marketing_sample
  type            String
  // Signed units (tins): receipts positive, outbound negative.
  quantityTins    Float
  // Signed grams (kg reference; 0 when the product has no gramsPerUnit).
  gramsEquivalent Float
  date            DateTime  @default(now())
  note            String?
  channel         String? // food_service | event | training
  createdAt       DateTime  @default(now())

  @@index([productId, date])
  @@index([date])
}

model PurchaseOrder {
  id                   String    @id @default(cuid())
  reference            String    @unique
  // draft | sent | confirmed | received | cancelled
  status               String    @default("draft")
  orderDate            DateTime  @default(now())
  expectedDeliveryDate DateTime
  receivedDate         DateTime?
  notes                String?
  // Original supplier PO file uploaded by the user (name only; parsed by AI).
  uploadedFileName     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  lines PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantityTins    Float
  unitCost        Float

  @@index([purchaseOrderId])
}

model Campaign {
  id            String    @id @default(cuid())
  name          String
  // event | promo | tasting
  type          String
  startDate     DateTime
  endDate       DateTime?
  // planned | active | completed | cancelled
  status        String    @default("planned")
  budget        Float?
  notes         String?
  results       String?
  resultRevenue Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products CampaignProduct[]
  assets   ContentAsset[]
}

model CampaignProduct {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
}

model ContentAsset {
  id          String    @id @default(cuid())
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  // caption | email | menu_description | event_invite
  type        String
  text        String
  createdByAI Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model Setting {
  key   String @id
  value String
}
