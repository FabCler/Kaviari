// Kaviari Cellar — caviar inventory, purchasing & marketing.
//
// SQLite for local dev. To switch to Postgres: change `provider` to
// "postgresql", point DATABASE_URL at the server, and re-run migrations.
// SQLite has no native enums, so status/type columns are strings validated
// by the zod schemas in lib/domain.ts — this also keeps the Postgres
// switch trivial.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id                     String  @id @default(cuid())
  // Canonical product code from the product database (PR Code).
  prCode                 String  @unique
  name                   String
  // Kristal | Oscietra | Baeri | Beluga | Daurikus | Transmontanus | Baenki
  caviarType             String?
  // Caviar | Marketing Tools | Fish Roe | Crab | Fish
  category               String  @default("Caviar")
  // Stock-keeping unit: Tin | PC | KG | PK
  unit                   String  @default("Tin")
  // Tins per full supplier box — orders are rounded up to whole boxes.
  packingPerBox          Int?
  // Net grams per unit (kg reference only; null for non-weighed items).
  gramsPerUnit           Int?
  unitCost               Float
  currency               String  @default("EUR")
  imageUrl               String?
  active                 Boolean @default(true)
  isPlaceholder          Boolean @default(false)
  // Manual ADU override (units/day) for seasonality or new products.
  aduOverrideUnitsPerDay Float?

  // ---- Supply-chain master fields (procurement / warehouse module) ----
  // Thai product name printed on Thai paperwork.
  nameTh             String?
  // Unit the product is *bought* in when it differs from the stock unit.
  purchaseUnit       String?
  // Purchase unit -> inventory unit factor (1 BOX = 10 Tin => 10).
  purchaseConversion Float?
  // Supplier minimum order quantity, expressed in the purchase unit.
  moq                Float?
  defaultSupplierId  String?
  defaultSupplier    Supplier? @relation(fields: [defaultSupplierId], references: [id], onDelete: SetNull)
  // True for products weighed piece by piece (fish, crab, shrimp): each
  // received item carries its own weight and is allocated individually.
  weightControlled   Boolean   @default(false)
  // Receiving refuses to save without a lot / an expiry date when set.
  lotRequired        Boolean   @default(false)
  expiryRequired     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lots      StockLot[]
  movements StockMovement[]
  poLines   PurchaseOrderLine[]
  campaigns CampaignProduct[]
  forecasts Forecast[]

  scmPrLines         ScmPurchaseRequestLine[]
  scmSoLines         ScmSalesOrderLine[]
  scmPoLines         ScmPurchaseOrderLine[]
  scmInvoiceLines    ScmInvoiceLine[]
  scmPoInvoiceRecons ScmPoInvoiceRecon[]
  scmSoPoRecons      ScmSoPoRecon[]
  scmReceivingLines  ScmReceivingLine[]
  scmAllocations     ScmAllocation[]
  scmShipmentLines   ScmShipmentLine[]
  scmUnitConversions ScmUnitConversion[]
  scmWarehouseStock  ScmWarehouseStock[]
  scmShortageCases   ScmShortageCase[]
  scmSoPoMappings    ScmSoPoMapping[]

  @@index([defaultSupplierId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("member") // owner | member
  status       String   @default("pending") // pending | approved | rejected
  // Supply-chain department driving the permission matrix:
  // admin | purchasing | sales | warehouse | management | none
  department   String   @default("none")
  // A sales user normally sees only the business channels assigned in
  // `channels`. A sales manager gets every channel — including channels
  // created after the account, which is why this is a flag and not a set
  // of rows to keep in step.
  allChannels  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  forecasts Forecast[]
  chats     ChatSession[]
  scmAudit  ScmAuditLog[]
  channels  ScmUserChannel[]
}

// One assistant conversation, private to its user.
model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model Forecast {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // First day of the forecast month (UTC midnight).
  month     DateTime
  // Forecast quantity in the product's unit (tins for caviar).
  quantity  Float
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, month])
  @@index([productId, month])
}

model StockLot {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  lotNumber    String
  // Units remaining in the lot (receipts add, consumption subtracts).
  quantityTins Float
  receivedTins Float
  receivedDate DateTime
  expiryDate   DateTime // DLC
  status       String   @default("in_stock") // in_stock | consumed | expired | written_off
  createdAt    DateTime @default(now())

  movements StockMovement[]

  @@index([productId, expiryDate])
}

model StockMovement {
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  lotId           String?
  lot             StockLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)
  // receipt | consumption | sale | waste | adjustment | marketing_sample
  type            String
  // Signed units (tins): receipts positive, outbound negative.
  quantityTins    Float
  // Signed grams (kg reference; 0 when the product has no gramsPerUnit).
  gramsEquivalent Float
  date            DateTime  @default(now())
  note            String?
  channel         String? // food_service | event | training
  createdAt       DateTime  @default(now())

  @@index([productId, date])
  @@index([date])
}

model PurchaseOrder {
  id                   String    @id @default(cuid())
  reference            String    @unique
  // draft | sent | confirmed | received | cancelled
  status               String    @default("draft")
  orderDate            DateTime  @default(now())
  expectedDeliveryDate DateTime
  receivedDate         DateTime?
  notes                String?
  // Original supplier PO file uploaded by the user (name only; parsed by AI).
  uploadedFileName     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  lines PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantityTins    Float
  unitCost        Float

  @@index([purchaseOrderId])
}

model Campaign {
  id            String    @id @default(cuid())
  name          String
  // event | promo | tasting
  type          String
  startDate     DateTime
  endDate       DateTime?
  // planned | active | completed | cancelled
  status        String    @default("planned")
  budget        Float?
  notes         String?
  results       String?
  resultRevenue Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products CampaignProduct[]
  assets   ContentAsset[]
}

model CampaignProduct {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
}

model ContentAsset {
  id          String    @id @default(cuid())
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  // caption | email | menu_description | event_invite
  type        String
  text        String
  createdByAI Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model Setting {
  key   String @id
  value String
}

// ===========================================================================
// SUPPLY CHAIN MODULE
// Customer Order -> SO/PR -> PO -> Supplier Invoice -> PO/Invoice recon ->
// Invoice/SO recon -> Warehouse receiving -> Allocation -> Shipment.
//
// Every model is prefixed `Scm` so it never collides with the replenishment
// side of the app (Product/StockLot/PurchaseOrder), and @@map gives the
// physical tables the plain names used in the data dictionary.
//
// Actor columns (`...ById` / `...ByName`) are deliberately denormalised
// snapshots without a foreign key: an audit record must keep showing who did
// what even after the account is renamed or removed. The one real FK to
// User is on ScmAuditLog, which is the module's traceability backbone.
// ===========================================================================

// ------------------------------------------------------- organisation model

// Business channel (§2). Channels are DATA, never an enum or a column name:
// adding "Wholesale" tomorrow is one row here plus its permission rows — no
// migration, no code change. Everything that filters by channel joins to this
// table, and `defaultPriority` seeds the ordering proposed (never applied on
// its own) when several channels compete for short stock.
model BusinessChannel {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  nameTh          String?
  sortOrder       Int      @default(0)
  // Lower goes first when management ranks channels on a shortage case.
  defaultPriority Int      @default(100)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customers           Customer[]
  salesOrders         ScmSalesOrder[]
  userChannels        ScmUserChannel[]
  tolerances          ScmTolerance[]
  warehouseStock      ScmWarehouseStock[]
  shortageAllocations ScmShortageAllocation[]

  @@map("business_channels")
}

// Which channels a sales user may see (§39). A sales manager gets
// `User.allChannels` instead, so a channel added later is covered without
// touching anyone's assignments.
model ScmUserChannel {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String
  channel   BusinessChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([userId, channelId])
  @@index([channelId])
  @@map("user_channels")
}

// Lookup tables for the labels the UI shows. Deliberately NOT foreign keys:
// `User.department` must keep resolving even on a database seeded before a
// department row exists, and an unknown code falls back to its own name.
model ScmDepartment {
  code      String   @id
  name      String
  nameTh    String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("departments")
}

model ScmRole {
  code        String   @id
  name        String
  nameTh      String?
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("roles")
}

// Tolerance master (§28). The most specific active row wins:
// supplier → channel → product type → global. A difference inside the
// tolerance is treated as a match and proceeds automatically; anything
// outside it needs a human.
model ScmTolerance {
  id                 String           @id @default(cuid())
  // "global" | "product_type" | "supplier" | "channel"
  scope              String           @default("global")
  // "<scope>:<value|*>" — one active rule per scope target.
  key                String           @unique
  productType        String?
  supplierId         String?
  supplier           Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  channelId          String?
  channel            BusinessChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  qtyTolerancePct    Float            @default(0)
  priceTolerancePct  Float            @default(0)
  weightTolerancePct Float            @default(0)
  note               String?
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([scope, active])
  @@map("tolerances")
}

// ---------------------------------------------------------------- master data

model Supplier {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  currency     String   @default("EUR")
  defaultUnit  String   @default("KG")
  moq          Float?
  leadTimeDays Int?
  contactEmail String?
  contactPhone String?
  address      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products       Product[]
  purchaseOrders ScmPurchaseOrder[]
  invoices       ScmInvoice[]
  receivings     ScmReceiving[]
  tolerances     ScmTolerance[]
  warehouseStock ScmWarehouseStock[]

  @@map("suppliers")
}

model Customer {
  id               String           @id @default(cuid())
  code             String           @unique
  name             String
  nameTh           String?
  // Every customer belongs to exactly one business channel (§3).
  channelId        String?
  channel          BusinessChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  deliveryLocation String?
  salesOwner       String?
  contactEmail     String?
  contactPhone     String?
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  salesOrders         ScmSalesOrder[]
  allocationLines     ScmAllocationLine[]
  shipments           ScmShipment[]
  shortageAllocations ScmShortageAllocation[]

  @@index([channelId])
  @@map("customers")
}

model ScmUnit {
  code      String   @id
  name      String
  // weight | count | volume — units of different dimensions never convert.
  dimension String   @default("count")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("units")
}

model ScmUnitConversion {
  id        String   @id @default(cuid())
  // "<productId|*>:<FROM>:<TO>" — SQLite treats NULLs as distinct in a
  // composite unique, so the scope is folded into one explicit key.
  key       String   @unique
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromUnit  String
  toUnit    String
  // quantity(toUnit) = quantity(fromUnit) * factor
  factor    Float
  createdAt DateTime @default(now())

  @@index([fromUnit, toUnit])
  @@map("unit_conversions")
}

// ------------------------------------------------------------------- demand

model ScmPurchaseRequest {
  id          String   @id @default(cuid())
  prNumber    String   @unique
  requester   String
  department  String   @default("sales")
  requestDate DateTime @default(now())
  // open | partially_ordered | ordered | cancelled
  status      String   @default("open")
  note        String?
  importId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines ScmPurchaseRequestLine[]

  @@map("purchase_requests")
}

model ScmPurchaseRequestLine {
  id            String             @id @default(cuid())
  prId          String
  pr            ScmPurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  lineNo        Int                @default(1)
  productId     String
  product       Product            @relation(fields: [productId], references: [id])
  // Requested quantity, expressed in `unit` (a stock or purchase unit).
  quantity      Float
  unit          String
  // Same quantity normalised to the product's inventory unit — the only
  // figure any cross-document comparison is allowed to use.
  baseQuantity  Float
  deliveryDate  DateTime
  // Sales line this demand comes from (a PR line may stand alone).
  soLineId      String?
  soLine        ScmSalesOrderLine? @relation(fields: [soLineId], references: [id], onDelete: SetNull)
  // PO number quoted by the purchasing import before that PO itself is
  // imported. The link is made when the PO file arrives (deferred join).
  poNumberRef   String?
  // Central 17-state workflow status (lib/scm/status.ts).
  status        String             @default("IMPORTED")
  blockedReason String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  demandLinks ScmSoPoMapping[]

  @@index([prId])
  @@index([productId, deliveryDate])
  @@index([status])
  @@index([poNumberRef])
  @@map("purchase_request_lines")
}

model ScmSalesOrder {
  id               String           @id @default(cuid())
  soNumber         String           @unique
  // Denormalised from the customer so every board can filter and group by
  // channel without a join, and so a customer moved between channels does
  // not rewrite the history of its past orders.
  channelId        String?
  channel          BusinessChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  customerId       String
  customer         Customer         @relation(fields: [customerId], references: [id])
  salesOwner       String?
  deliveryLocation String?
  orderDate        DateTime         @default(now())
  deliveryDate     DateTime
  requester        String?
  currency         String           @default("THB")
  // open | partially_shipped | shipped | closed | cancelled
  status           String           @default("open")
  notes            String?
  importId         String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  lines ScmSalesOrderLine[]

  @@index([customerId])
  @@index([channelId, deliveryDate])
  @@map("sales_orders")
}

model ScmSalesOrderLine {
  id                String        @id @default(cuid())
  soId              String
  so                ScmSalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  lineNo            Int           @default(1)
  productId         String
  product           Product       @relation(fields: [productId], references: [id])
  quantity          Float
  unit              String
  baseQuantity      Float
  unitPrice         Float         @default(0)
  // Unit the price is quoted per (e.g. price per KG while selling BOX).
  priceUnit         String?
  currency          String        @default("THB")
  deliveryDate      DateTime
  // Quantity on the original customer order — never overwritten, so a
  // reduction agreed with the customer stays visible.
  originalQuantity  Float
  // Quantity confirmed after the Invoice/SO review (source of truth for
  // allocation). Null until Sales has reviewed.
  confirmedQuantity Float?
  // See ScmPurchaseRequestLine.poNumberRef.
  poNumberRef       String?
  status            String        @default("IMPORTED")
  blockedReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  prLines             ScmPurchaseRequestLine[]
  demandLinks         ScmSoPoMapping[]
  soPoRecons          ScmSoPoRecon[]
  allocationLines     ScmAllocationLine[]
  shipmentLines       ScmShipmentLine[]
  shortageAllocations ScmShortageAllocation[]
  warehouseStock      ScmWarehouseStock[]

  @@index([soId])
  @@index([productId, deliveryDate])
  @@index([status])
  @@index([poNumberRef])
  @@map("sales_order_lines")
}

// ----------------------------------------------------------------- purchase

model ScmPurchaseOrder {
  id                   String   @id @default(cuid())
  poNumber             String   @unique
  supplierId           String
  supplier             Supplier @relation(fields: [supplierId], references: [id])
  orderDate            DateTime @default(now())
  expectedDeliveryDate DateTime
  currency             String   @default("EUR")
  // draft | issued | confirmed | invoiced | received | closed | cancelled
  status               String   @default("draft")
  notes                String?
  importId             String?
  createdById          String?
  createdByName        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  lines          ScmPurchaseOrderLine[]
  invoices       ScmInvoice[]
  recons         ScmPoInvoiceRecon[]
  receivings     ScmReceiving[]
  soPoMapping    ScmSoPoMapping[]
  warehouseStock ScmWarehouseStock[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model ScmPurchaseOrderLine {
  id                String           @id @default(cuid())
  poId              String
  po                ScmPurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  lineNo            Int              @default(1)
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  // Ordered quantity in the purchase unit.
  quantity          Float
  unit              String
  // Ordered quantity normalised to the inventory unit.
  baseQuantity      Float
  unitPrice         Float            @default(0)
  priceUnit         String?
  currency          String           @default("EUR")
  deliveryDate      DateTime
  // Demand this line covers (sum of the linked PR/SO lines), inventory unit.
  requiredQuantity  Float            @default(0)
  moq               Float?
  // Mandatory when quantity > requiredQuantity:
  // MOQ | PACK_SIZE | CARTON_SIZE | MIN_ORDER_VALUE | SUPPLIER_REQUIREMENT |
  // SAFETY_STOCK | OTHER
  adjustmentReason  String?
  adjustmentNote    String?
  // Quantity agreed with the supplier after the invoice reconciliation.
  // Once set this — not `quantity` — drives every downstream step.
  correctedQuantity Float?
  correctedReason   String?
  correctedAt       DateTime?
  correctedByName   String?
  remark            String?
  status            String           @default("PO_CREATED")
  blockedReason     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  demandLinks    ScmSoPoMapping[]
  invoiceLines   ScmInvoiceLine[]
  recons         ScmPoInvoiceRecon[]
  soPoRecons     ScmSoPoRecon[]
  receivingLines ScmReceivingLine[]
  allocations    ScmAllocation[]
  shortageCases  ScmShortageCase[]
  warehouseStock ScmWarehouseStock[]

  @@index([poId])
  @@index([productId, deliveryDate])
  @@index([status])
  @@map("purchase_order_lines")
}

// SO ↔ PO mapping (§6, §7). There is deliberately NO direct SO → PO column
// anywhere: one PO covers many SO lines and one SO line is split across many
// POs, so the relationship lives here, at line level, with the quantity it
// carries and the reason it was split that way.
model ScmSoPoMapping {
  id            String                  @id @default(cuid())
  poId          String
  po            ScmPurchaseOrder        @relation(fields: [poId], references: [id], onDelete: Cascade)
  poLineId      String
  poLine        ScmPurchaseOrderLine    @relation(fields: [poLineId], references: [id], onDelete: Cascade)
  soId          String?
  soLineId      String?
  soLine        ScmSalesOrderLine?      @relation(fields: [soLineId], references: [id], onDelete: SetNull)
  prLineId      String?
  prLine        ScmPurchaseRequestLine? @relation(fields: [prLineId], references: [id], onDelete: SetNull)
  productId     String
  product       Product                 @relation(fields: [productId], references: [id])
  // Share of the PO line covering this demand, in the inventory unit.
  quantity      Float
  unit          String
  // Why the demand was split this way (partial supplier, split delivery…).
  reason        String?
  createdById   String?
  createdByName String?
  createdAt     DateTime                @default(now())

  @@index([poLineId])
  @@index([prLineId])
  @@index([soLineId])
  @@index([soId])
  @@map("so_po_mapping")
}

// ------------------------------------------------------------------ invoice

model ScmInvoice {
  id              String            @id @default(cuid())
  invoiceNumber   String
  supplierId      String?
  supplier        Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  poId            String?
  po              ScmPurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  // Raw values exactly as extracted, kept even when they match nothing.
  supplierCodeRaw String?
  supplierNameRaw String?
  poNumberRaw     String?
  invoiceDate     DateTime?
  deliveryDate    DateTime?
  currency        String            @default("EUR")
  // uploaded | processing | extracted | pending_verification | verified | rejected
  status          String            @default("uploaded")
  fileName        String?
  fileSize        Int?
  // Whole extraction payload as returned by the reader, for audit.
  extractionRaw   String?
  extractionError String?
  // "ai" | "manual"
  extractionMode  String            @default("ai")
  uploadedById    String?
  uploadedByName  String?
  verifiedByName  String?
  verifiedAt      DateTime?
  rejectReason    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  lines  ScmInvoiceLine[]
  recons ScmPoInvoiceRecon[]

  @@unique([invoiceNumber, supplierId])
  @@index([poId])
  @@index([status])
  @@map("invoices")
}

model ScmInvoiceLine {
  id             String                @id @default(cuid())
  invoiceId      String
  invoice        ScmInvoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNo         Int                   @default(1)
  productId      String?
  product        Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  productCodeRaw String?
  descriptionRaw String?
  quantity       Float
  unit           String
  baseQuantity   Float
  unitPrice      Float                 @default(0)
  priceUnit      String?
  currency       String                @default("EUR")
  deliveryDate   DateTime?
  poLineId       String?
  poLine         ScmPurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)
  // Comma-separated field names a human corrected after extraction.
  editedFields   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  recons ScmPoInvoiceRecon[]

  @@index([invoiceId])
  @@index([poLineId])
  @@map("invoice_lines")
}

// ----------------------------------------------------------- reconciliation

model ScmPoInvoiceRecon {
  id            String               @id @default(cuid())
  poId          String
  po            ScmPurchaseOrder     @relation(fields: [poId], references: [id], onDelete: Cascade)
  poLineId      String
  poLine        ScmPurchaseOrderLine @relation(fields: [poLineId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       ScmInvoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceLineId String?
  invoiceLine   ScmInvoiceLine?      @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)
  productId     String
  product       Product              @relation(fields: [productId], references: [id])

  poQuantity       Float
  invoiceQuantity  Float?
  qtyDiff          Float?
  qtyDiffPct       Float?
  poUnitPrice      Float
  invoiceUnitPrice Float?
  priceDiff        Float?
  priceDiffPct     Float?
  // match | over | short | missing_on_invoice | not_on_po
  qtyStatus        String @default("match")
  // match | higher | lower | missing
  priceStatus      String @default("match")

  correctedQuantity Float?
  quantityReason    String?
  priceReason       String?
  remark            String?
  // pending_review | purchasing_review | approved | rejected
  status            String    @default("pending_review")
  reviewedByName    String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([poLineId, invoiceLineId])
  @@index([poId])
  @@index([status])
  @@map("po_invoice_reconciliation")
}

model ScmSoPoRecon {
  id        String                @id @default(cuid())
  soLineId  String
  soLine    ScmSalesOrderLine     @relation(fields: [soLineId], references: [id], onDelete: Cascade)
  poLineId  String?
  poLine    ScmPurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)
  productId String
  product   Product               @relation(fields: [productId], references: [id])

  soQuantity        Float
  // Corrected PO / invoice quantity available for this SO line.
  confirmedQuantity Float
  diff              Float
  diffPct           Float
  // match | short | over
  diffStatus        String @default("match")

  // reduce_so | keep_so | increase_customer | warehouse_stock | split
  decision         String?
  reason           String?
  customerAccepted Boolean?
  newSoQuantity    Float?
  remark           String?
  // pending_sales_review | completed | cancelled
  status           String    @default("pending_sales_review")
  reviewedByName   String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([soLineId])
  @@index([status])
  @@map("so_po_reconciliation")
}

// --------------------------------------------------------------- allocation

model ScmAllocation {
  id                  String                @id @default(cuid())
  allocationNumber    String                @unique
  productId           String
  product             Product               @relation(fields: [productId], references: [id])
  poLineId            String?
  poLine              ScmPurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)
  // Quantity actually available (corrected PO/invoice quantity, or the
  // weighed total once the warehouse has counted).
  actualQuantity      Float
  unit                String
  allocatedQuantity   Float                 @default(0)
  warehouseQuantity   Float                 @default(0)
  unallocatedQuantity Float                 @default(0)
  // draft | completed | cancelled
  status              String                @default("draft")
  createdByName       String?
  completedByName     String?
  completedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  lines ScmAllocationLine[]

  @@index([productId])
  @@index([status])
  @@map("allocation")
}

model ScmAllocationLine {
  id              String             @id @default(cuid())
  allocationId    String
  allocation      ScmAllocation      @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  // customer | warehouse
  target          String             @default("customer")
  customerId      String?
  customer        Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  soLineId        String?
  soLine          ScmSalesOrderLine? @relation(fields: [soLineId], references: [id], onDelete: SetNull)
  quantity        Float
  unit            String
  storageLocation String?
  reason          String?
  responsibleDept String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items          ScmReceivingItem[]
  shipmentLines  ScmShipmentLine[]
  warehouseStock ScmWarehouseStock[]

  @@index([allocationId])
  @@index([customerId])
  @@map("allocation_lines")
}

// ---------------------------------------------------------------- receiving

model ScmReceiving {
  id             String           @id @default(cuid())
  receiptNumber  String           @unique
  poId           String
  po             ScmPurchaseOrder @relation(fields: [poId], references: [id])
  invoiceId      String?
  supplierId     String
  supplier       Supplier         @relation(fields: [supplierId], references: [id])
  receivedDate   DateTime         @default(now())
  // draft | received | partial_received | completed | blocked | cancelled
  status         String           @default("draft")
  blockedReason  String?
  receivedByName String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  lines ScmReceivingLine[]

  @@index([poId])
  @@index([status])
  @@map("receiving")
}

model ScmReceivingLine {
  id               String               @id @default(cuid())
  receivingId      String
  receiving        ScmReceiving         @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  poLineId         String
  poLine           ScmPurchaseOrderLine @relation(fields: [poLineId], references: [id])
  productId        String
  product          Product              @relation(fields: [productId], references: [id])
  expectedQuantity Float
  actualQuantity   Float                @default(0)
  unit             String
  lotNumber        String?
  expiryDate       DateTime?
  storageLocation  String?
  // pending | received | partial | rejected
  status           String               @default("pending")
  remark           String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  items          ScmReceivingItem[]
  warehouseStock ScmWarehouseStock[]

  @@index([receivingId])
  @@index([poLineId])
  @@map("receiving_lines")
}

// One physical piece of a weight-controlled product (Fish 01, Fish 02…).
model ScmReceivingItem {
  id               String             @id @default(cuid())
  receivingLineId  String
  receivingLine    ScmReceivingLine   @relation(fields: [receivingLineId], references: [id], onDelete: Cascade)
  itemNo           String
  weight           Float
  unit             String             @default("KG")
  lotNumber        String?
  expiryDate       DateTime?
  storageLocation  String?
  // good | damaged | rejected — recorded piece by piece on arrival.
  condition        String             @default("good")
  receivedAt       DateTime           @default(now())
  allocationLineId String?
  allocationLine   ScmAllocationLine? @relation(fields: [allocationLineId], references: [id], onDelete: SetNull)
  // on_hand | allocated | shipped | written_off
  status           String             @default("on_hand")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([receivingLineId, itemNo])
  @@index([allocationLineId])
  @@map("receiving_items")
}

// ----------------------------------------------------------------- shipment

model ScmShipment {
  id               String   @id @default(cuid())
  shipmentNumber   String   @unique
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  shipDate         DateTime @default(now())
  deliveryLocation String?
  // draft | picked | shipped | delivered | cancelled
  status           String   @default("draft")
  createdByName    String?
  shippedByName    String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lines ScmShipmentLine[]

  @@index([customerId])
  @@index([status])
  @@map("shipment")
}

model ScmShipmentLine {
  id               String             @id @default(cuid())
  shipmentId       String
  shipment         ScmShipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  allocationLineId String?
  allocationLine   ScmAllocationLine? @relation(fields: [allocationLineId], references: [id], onDelete: SetNull)
  soLineId         String?
  soLine           ScmSalesOrderLine? @relation(fields: [soLineId], references: [id], onDelete: SetNull)
  productId        String
  product          Product            @relation(fields: [productId], references: [id])
  quantity         Float
  unit             String
  weight           Float?
  // Comma-separated ScmReceivingItem ids for weight-controlled products.
  itemRefs         String?
  createdAt        DateTime           @default(now())

  @@index([shipmentId])
  @@map("shipment_lines")
}

// ---------------------------------------------------- exceptions & controls

model ScmException {
  id              String    @id @default(cuid())
  code            String    @unique
  // See EXCEPTION_TYPES in lib/scm/domain.ts
  type            String
  // low | medium | high
  severity        String    @default("medium")
  documentType    String?
  documentId      String?
  documentNumber  String?
  productId       String?
  description     String
  reason          String?
  responsibleDept String
  // The person accountable, not just the department (§26, §27).
  ownerName       String?
  // low | medium | high | critical — drives the Exception Center ordering.
  priority        String    @default("medium")
  channelId       String?
  action          String?
  dueDate         DateTime?
  // open | in_progress | resolved | cancelled
  status          String    @default("open")
  createdByName   String?
  resolvedByName  String?
  resolvedAt      DateTime?
  resolution      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, responsibleDept])
  @@index([documentType, documentId])
  @@map("exceptions")
}

model ScmAuditLog {
  id             String   @id @default(cuid())
  entity         String
  entityId       String
  documentNumber String?
  // create | update | delete | status_change | approve | reject | import | override
  action         String
  field          String?
  oldValue       String?
  newValue       String?
  reason         String?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName       String?
  department     String?
  createdAt      DateTime @default(now())

  @@index([entity, entityId])
  @@index([documentNumber])
  @@index([createdAt])
  @@map("audit_logs")
}

model ScmAttachment {
  id             String   @id @default(cuid())
  entity         String
  entityId       String
  fileName       String
  mimeType       String?
  size           Int?
  // Extracted text / small payloads kept inline; large binaries belong in
  // object storage once this leaves the prototype stage.
  content        String?
  uploadedByName String?
  createdAt      DateTime @default(now())

  @@index([entity, entityId])
  @@map("attachments")
}

model ScmNotification {
  id             String    @id @default(cuid())
  department     String
  // Null = every channel. Set, and only users who can see that channel get it.
  channelId      String?
  type           String
  severity       String    @default("info")
  title          String
  body           String?
  documentType   String?
  documentId     String?
  documentNumber String?
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([department, readAt])
  @@map("notifications")
}

model ScmImportBatch {
  id            String   @id @default(cuid())
  // demand | po | so | invoice
  kind          String
  fileName      String
  rowCount      Int      @default(0)
  okCount       Int      @default(0)
  errorCount    Int      @default(0)
  // validated | committed | failed
  status        String   @default("validated")
  // JSON: validation issues kept for the audit trail.
  issues        String?
  // JSON: the validated rows, held between the preview and the confirmation
  // so the user confirms exactly what was checked (no second parse).
  payload       String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([kind, createdAt])
  @@map("import_batches")
}

// --------------------------------------------------- warehouse stock (§24)

// Everything received that did not go straight to a customer. It keeps the
// whole chain that produced it — supplier, PO, invoice, the SO it was bought
// for and the channel — so leftover in the freezer can always be traced back
// to the order it came from.
model ScmWarehouseStock {
  id               String             @id @default(cuid())
  stockNumber      String             @unique
  productId        String
  product          Product            @relation(fields: [productId], references: [id])
  quantity         Float
  unit             String
  supplierId       String?
  supplier         Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  poId             String?
  po               ScmPurchaseOrder?  @relation(fields: [poId], references: [id], onDelete: SetNull)
  invoiceId        String?
  originalSoLineId String?
  originalSoLine   ScmSalesOrderLine? @relation(fields: [originalSoLineId], references: [id], onDelete: SetNull)
  channelId        String?
  channel          BusinessChannel?   @relation(fields: [channelId], references: [id], onDelete: SetNull)
  receivingLineId  String?
  receivingLine    ScmReceivingLine?  @relation(fields: [receivingLineId], references: [id], onDelete: SetNull)
  allocationLineId String?
  allocationLine   ScmAllocationLine? @relation(fields: [allocationLineId], references: [id], onDelete: SetNull)
  reason           String?
  location         String?
  lotNumber        String?
  expiryDate       DateTime?
  // on_hand | reserved | consumed | written_off
  status           String             @default("on_hand")
  createdByName    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  transactions           ScmWarehouseStockTransaction[]
  scmPurchaseOrderLine   ScmPurchaseOrderLine?          @relation(fields: [scmPurchaseOrderLineId], references: [id])
  scmPurchaseOrderLineId String?

  @@index([productId, status])
  @@index([channelId])
  @@map("warehouse_stock")
}

model ScmWarehouseStockTransaction {
  id            String            @id @default(cuid())
  stockId       String
  stock         ScmWarehouseStock @relation(fields: [stockId], references: [id], onDelete: Cascade)
  // in | out | adjust | reserve | release | write_off
  type          String
  quantity      Float
  balanceAfter  Float
  reason        String?
  referenceType String?
  referenceId   String?
  byName        String?
  createdAt     DateTime          @default(now())

  @@index([stockId, createdAt])
  @@map("warehouse_stock_transactions")
}

// ------------------------------------------------ cross-channel shortage (§20)

// When one delivery cannot cover the demand of several channels, the system
// stops and hands the decision to a person. It never reduces a customer on
// its own: it lays out the shortfall per channel, proposes a split from the
// channel priorities, and waits for an approval.
model ScmShortageCase {
  id               String                @id @default(cuid())
  caseNumber       String                @unique
  productId        String
  product          Product               @relation(fields: [productId], references: [id])
  poLineId         String?
  poLine           ScmPurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)
  deliveryDate     DateTime?
  actualQuantity   Float
  totalSoQuantity  Float
  shortageQuantity Float
  unit             String
  // open | pending_approval | approved | rejected | applied | cancelled
  status           String                @default("pending_approval")
  decisionNote     String?
  approvedByName   String?
  approvedAt       DateTime?
  createdByName    String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  lines ScmShortageAllocation[]

  @@index([status])
  @@map("shortage_cases")
}

model ScmShortageAllocation {
  id                String             @id @default(cuid())
  caseId            String
  shortageCase      ScmShortageCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  channelId         String?
  channel           BusinessChannel?   @relation(fields: [channelId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  soLineId          String?
  soLine            ScmSalesOrderLine? @relation(fields: [soLineId], references: [id], onDelete: SetNull)
  requestedQuantity Float
  // What the approver decided this channel/customer actually gets.
  approvedQuantity  Float?
  // Lower goes first. Seeded from the channel's default priority.
  priority          Int                @default(100)
  reason            String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([caseId])
  @@map("shortage_allocations")
}
