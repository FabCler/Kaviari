# SQLite. On Railway use a mounted volume so the file survives deploys:
#   DATABASE_URL="file:/data/dc2.db"   (volume mounted at /data)
DATABASE_URL="file:./dev.db"

# Public URL of the app.
APP_URL="http://localhost:3000"

# Secret used to sign session cookies. MUST be changed in production —
# anyone who knows it can mint a session for any account.
APP_SECRET="change-me-to-a-long-random-string"

# The account registering with this email becomes the owner (auto-approved,
# full access, can approve everybody else).
OWNER_EMAIL="fabien@thammachartseafood.com"

# Reading a scanned PDF (a supplier invoice that is a photograph, not a text
# file). Leave this unset and the app simply says a scan cannot be read; set it
# and a "Read the scan" button appears on the import screen. The document is
# sent to Anthropic's API to be read, and what comes back is checked line by
# line in the import preview before anything is saved.
ANTHROPIC_API_KEY=""
