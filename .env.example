# SQLite for local dev. Switch to Postgres by changing provider in
# prisma/schema.prisma and pointing this at your server, e.g.
# DATABASE_URL="postgresql://user:pass@localhost:5432/kaviari"
DATABASE_URL="file:./dev.db"

# PIN gate for the app (staff login). Change it in production.
APP_PIN="1234"
# Secret used to sign the session cookie. Change it in production.
APP_SECRET="change-me-to-a-long-random-string"

# Anthropic API — powers the assistant, import analysis and content studio.
# The app works without it; AI features show a friendly notice instead.
ANTHROPIC_API_KEY=""
# Optional model override.
# ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"
