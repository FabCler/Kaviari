# SQLite for local dev. Switch to Postgres by changing provider in
# prisma/schema.prisma and pointing this at your server.
# On Railway: file:/data/kaviari.db (with a volume mounted at /data)
DATABASE_URL="file:./dev.db"

# Public URL of the app (used in approval-email links).
APP_URL="http://localhost:3000"

# Secret used to sign session cookies and approval links. Change in production.
APP_SECRET="change-me-to-a-long-random-string"

# The account with this email becomes the owner on registration.
OWNER_EMAIL="fabien@thammachartseafood.com"

# SMTP — optional, reserved for future email notifications.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Anthropic API — powers the assistant, import analysis, PO parsing and
# content studio. The app works without it; AI features show a notice.
ANTHROPIC_API_KEY=""
# Optional model override (default: claude-opus-5).
# ANTHROPIC_MODEL="claude-opus-5"
